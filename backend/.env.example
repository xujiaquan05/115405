# backend/.env.example
#
# 複製成 .env 後填入自己的值：cp .env.example .env
# 這份檔案要列出「程式讀得到的每一個環境變數」——
# tests/test_env_example.py 會比對，漏掉會讓 CI 失敗。

# ── 必填 ─────────────────────────────────────────────
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/medical_beauty_db
GOOGLE_API_KEY=your_google_api_key

# JWT 簽章金鑰。沒設定的話系統每次啟動都會產生隨機值，
# 結果是「後端一重啟，所有人就被登出」。
# 產生方式：python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change_me_to_a_long_random_string

# ── 部署環境 ─────────────────────────────────────────
# 只要不是 development，登入 cookie 就會加上 Secure、並送出 HSTS。
# 正式部署務必設成 production，否則等於關掉這兩項防護。
APP_ENV=development
APP_NAME=Medical Beauty Public Opinion System
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ── 帳號安全 ─────────────────────────────────────────
JWT_EXPIRE_HOURS=12
# 首次啟動建立預設管理員時使用；未設定會用 admin123 並發出警告。
ADMIN_PASSWORD=change_me_admin_password
# 連續登入失敗幾次就鎖定帳號、鎖多久（分鐘）。
MAX_FAILED_LOGINS=5
LOCKOUT_MINUTES=15
# 密碼雜湊迭代次數。正式值為 600000（OWASP 建議），
# 測試會調低以加快速度，正常情況不需要設定這一項。
PBKDF2_ITERATIONS=600000

# ── Gemini ───────────────────────────────────────────
GEMINI_MODEL=gemini-2.5-flash-lite

# ── 自動爬取排程 ─────────────────────────────────────
AUTO_CRAWL_ENABLED=true
AUTO_CRAWL_HOUR=3
AUTO_CRAWL_PAGES=2

# Dcard / Mobile01 / Threads 需要真實瀏覽器（Playwright + Chromium）。
# 部署到沒有瀏覽器的環境（例如 Render）時要設成 false，
# 否則每日排程會天天嘗試並失敗。
DCARD_CRAWL_ENABLED=true
MOBILE01_CRAWL_ENABLED=true
THREADS_CRAWL_ENABLED=true

# ── 輿情預警門檻 ─────────────────────────────────────
ALERT_WARNING_NEGATIVE=25
ALERT_CRITICAL_NEGATIVE=40
ALERT_MIN_ARTICLES=5
# 同一關鍵字幾小時內不重複發預警。
ALERT_DEDUPE_HOURS=6
